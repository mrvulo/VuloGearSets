package-as: VuloGearSets

# Der Repo-Wurzelordner IST der Addon-Ordner. Alles, was nicht ins
# Auslieferungspaket gehoert, hier ausschliessen.
ignore:
  - .github
  - .gitignore
  - docs
  - tools
  - README.md
  - CONTRIBUTING.md

# Keine externen Bibliotheken - das Addon kommt ohne Libs aus.
enable-nolib-creation: no

manual-changelog: CHANGELOG.md
